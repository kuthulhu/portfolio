---
import Vinyl from '../assets/Vinyl.svg';
---

{/* Spotify's iFrame API loader pulls its script from here; connecting early shortens the player's setup. */}
<link rel="preconnect" href="https://embed-cdn.spotifycdn.com" />

{/* Filled in from /spotify.json, which .github/workflows/update-spotify.yml keeps current. */}
<div
  data-recently-played
  class="fixed right-[max(16px,env(safe-area-inset-right))] bottom-[max(16px,env(safe-area-inset-bottom))]"
>
  {/* Positioned off the vinyl so showing it never moves the vinyl. Two body-sm
      lines plus py-px and the border come to 48px, the vinyl's height.
      Width is capped at the space left of the vinyl: viewport minus both gutters, the 48px vinyl and the gap. */}
  <p
    data-track
    hidden
    class="recently-played-label pointer-events-none absolute inset-y-0 right-full my-auto mr-2 h-fit w-max max-w-[min(240px,calc(100vw-88px))] rounded-md border border-line bg-bg/85 px-2.5 py-px text-right text-body-sm backdrop-blur-sm"
  >
    <span data-song class="block truncate font-medium text-fg"></span>
    <span data-artist class="block truncate text-muted"></span>
  </p>
  <button
    type="button"
    data-vinyl-button
    disabled
    aria-pressed="false"
    aria-label="Recently played"
    class="cursor-pointer rounded-full text-fg disabled:cursor-default"
  >
    <Vinyl width={48} height={48} aria-hidden="true" class="vinyl" />
  </button>
  {/* Spotify's embedded player, replaced by its iframe once the iFrame API loads.
      Kept invisible but on screen (1px, transparent) rather than display: none,
      since browsers throttle frames they consider hidden. The vinyl drives it. */}
  <div aria-hidden="true" inert class="pointer-events-none absolute right-0 bottom-0 size-px overflow-hidden opacity-0">
    <div data-spotify-embed></div>
  </div>
</div>

<script>
  interface RecentlyPlayed {
    songName: string;
    artistName: string;
    trackUrl: string;
  }

  // The parts of Spotify's iFrame API used here:
  // https://developer.spotify.com/documentation/embeds/references/iframe-api
  interface PlaybackUpdate {
    data: { isPaused: boolean; position: number; duration: number };
  }
  interface EmbedController {
    togglePlay(): void;
    addListener(event: 'playback_update', callback: (update: PlaybackUpdate) => void): void;
  }
  interface IFrameAPI {
    createController(
      element: HTMLElement,
      options: { uri: string; width: number; height: number },
      callback: (controller: EmbedController) => void,
    ): void;
  }

  const root = document.querySelector<HTMLElement>('[data-recently-played]')!;
  const label = root.querySelector<HTMLElement>('[data-track]')!;
  const button = root.querySelector<HTMLButtonElement>('[data-vinyl-button]')!;
  const embed = root.querySelector<HTMLElement>('[data-spotify-embed]')!;
  const vinyl = button.querySelector<SVGElement>('.vinyl')!;

  // How long before the end the label fades out and the vinyl slows to rest.
  // Spotify's player has no volume control, so the audio itself can't fade.
  const WIND_DOWN_MS = 2000;

  // How long a tap's play or pause is shown before the player has confirmed it.
  // If the player hasn't caught up by then, the vinyl goes back to what it reports.
  const CONFIRM_TIMEOUT_MS = 5000;

  // Starts loading Spotify's iFrame API straight away, alongside /spotify.json, rather than after it.
  const iframeApi = new Promise<IFrameAPI>((resolve, reject) => {
    (window as Window & { onSpotifyIframeApiReady?: (api: IFrameAPI) => void }).onSpotifyIframeApiReady = resolve;
    const script = document.createElement('script');
    script.src = 'https://open.spotify.com/embed/iframe-api/v1';
    script.async = true;
    script.onerror = reject;
    document.head.append(script);
  });
  // Handled in loadPlayer; this only stops an unhandled rejection if /spotify.json never loads.
  iframeApi.catch(() => {});

  // Resolves with the embed's controller once Spotify's player is ready to play.
  const loadPlayer = async (uri: string) => {
    const api = await iframeApi;
    return new Promise<EmbedController>((resolve) => api.createController(embed, { uri, width: 300, height: 80 }, resolve));
  };

  const load = async () => {
    const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
    const res = await fetch(`${base}spotify.json`, { cache: 'no-cache' });
    if (!res.ok) return;
    const track: RecentlyPlayed = await res.json();
    const title = `${track.songName} by ${track.artistName}`;
    const trackId = new URL(track.trackUrl).pathname.split('/').pop();

    label.querySelector('[data-song]')!.textContent = track.songName;
    label.querySelector('[data-artist]')!.textContent = track.artistName;
    label.title = title;
    button.disabled = false;

    // Last position the player reported, and when, so it can be estimated between updates.
    let playback = { position: 0, duration: 0, at: 0 };
    let frame = 0;

    // 1 while playing normally, falling to 0 over the last WIND_DOWN_MS. Scales the
    // label's opacity and the spin's playback rate; changing the rate (rather than
    // the duration) slows the record from its current angle without a jump.
    const windDown = (factor: number) => {
      label.style.opacity = factor < 1 ? String(factor) : '';
      vinyl.getAnimations()[0]?.updatePlaybackRate(factor);
    };

    const tick = () => {
      const remaining = playback.duration - (playback.position + performance.now() - playback.at);
      windDown(playback.duration > 0 ? Math.min(Math.max(remaining / WIND_DOWN_MS, 0), 1) : 1);
      frame = requestAnimationFrame(tick);
    };

    const setPlaying = (playing: boolean) => {
      cancelAnimationFrame(frame);
      // Back to full speed while stopped, ready for the next play.
      if (playing) frame = requestAnimationFrame(tick);
      else windDown(1);
      root.toggleAttribute('data-playing', playing);
      // The song is only shown while it plays; the label fades in each time.
      label.hidden = !playing;
      button.ariaPressed = String(playing);
      button.ariaLabel = `${playing ? 'Pause' : 'Play'} ${title}`;
    };
    setPlaying(false);

    // A tap is shown at once, before Spotify has fetched the audio, so there's no
    // visible delay. Until the player confirms, updates that still report the old
    // state are ignored; `reported` is what the player last said.
    let expected: boolean | undefined;
    let reported = false;
    let confirmTimer = 0;

    const request = (playing: boolean) => {
      if (playing) {
        // The position is frozen until the player reports again, and a finished track restarts.
        const position = playback.position >= playback.duration ? 0 : playback.position;
        playback = { ...playback, position, at: performance.now() };
      }
      expected = playing;
      setPlaying(playing);
      clearTimeout(confirmTimer);
      confirmTimer = window.setTimeout(() => {
        expected = undefined;
        setPlaying(reported);
      }, CONFIRM_TIMEOUT_MS);
    };

    // Until the player is ready (or if it is blocked), the vinyl opens the song on Spotify instead.
    let controller: EmbedController | undefined;
    button.addEventListener('click', () => {
      if (!controller) {
        window.open(track.trackUrl, '_blank', 'noopener');
        return;
      }
      controller.togglePlay();
      request(!root.hasAttribute('data-playing'));
    });

    controller = await loadPlayer(`spotify:track:${trackId}`);
    // Driven by the player's own updates, so the state also stays right when
    // playback stops on its own. At the end of the track the player can report
    // its position at the full duration without pausing, so that counts as stopped.
    controller.addListener('playback_update', ({ data }) => {
      playback = { position: data.position, duration: data.duration, at: performance.now() };
      reported = !data.isPaused && !(data.duration > 0 && data.position >= data.duration);
      if (expected !== undefined) {
        if (reported !== expected) return;
        expected = undefined;
        clearTimeout(confirmTimer);
      }
      if (reported !== root.hasAttribute('data-playing')) setPlaying(reported);
    });
  };

  load().catch(() => {});
</script>
