---
import Vinyl from '../assets/Vinyl.svg';
---

{/* Filled in from /spotify.json, which .github/workflows/update-spotify.yml keeps current. */}
<div
  data-recently-played
  class="fixed right-[max(16px,env(safe-area-inset-right))] bottom-[max(16px,env(safe-area-inset-bottom))]"
>
  {/* Positioned off the vinyl so showing it never moves the vinyl. Two body-sm
      lines plus py-px and the border come to 48px, the vinyl's height.
      Width is capped at the space left of the vinyl: viewport minus both gutters, the 48px vinyl and the gap. */}
  <p
    data-track
    hidden
    class="recently-played-label pointer-events-none absolute inset-y-0 right-full my-auto mr-2 h-fit w-max max-w-[min(240px,calc(100vw-88px))] rounded-md border border-line bg-bg/85 px-2.5 py-px text-right text-body-sm backdrop-blur-sm"
  >
    <span data-song class="block truncate font-medium text-fg"></span>
    <span data-artist class="block truncate text-muted"></span>
  </p>
  <button
    type="button"
    data-vinyl-button
    disabled
    aria-pressed="false"
    aria-label="Recently played"
    class="cursor-pointer rounded-full text-fg disabled:cursor-default"
  >
    <Vinyl width={48} height={48} aria-hidden="true" class="vinyl" />
  </button>
  {/* Spotify's embedded player, replaced by its iframe once the iFrame API loads.
      Kept invisible but on screen (1px, transparent) rather than display: none,
      since browsers throttle frames they consider hidden. The vinyl drives it. */}
  <div aria-hidden="true" inert class="pointer-events-none absolute right-0 bottom-0 size-px overflow-hidden opacity-0">
    <div data-spotify-embed></div>
  </div>
</div>

<script>
  interface RecentlyPlayed {
    songName: string;
    artistName: string;
    trackUrl: string;
  }

  // The parts of Spotify's iFrame API used here:
  // https://developer.spotify.com/documentation/embeds/references/iframe-api
  interface PlaybackUpdate {
    data: { isPaused: boolean; position: number; duration: number };
  }
  interface EmbedController {
    togglePlay(): void;
    addListener(event: 'playback_update', callback: (update: PlaybackUpdate) => void): void;
  }
  interface IFrameAPI {
    createController(
      element: HTMLElement,
      options: { uri: string; width: number; height: number },
      callback: (controller: EmbedController) => void,
    ): void;
  }

  const root = document.querySelector<HTMLElement>('[data-recently-played]')!;
  const label = root.querySelector<HTMLElement>('[data-track]')!;
  const button = root.querySelector<HTMLButtonElement>('[data-vinyl-button]')!;
  const embed = root.querySelector<HTMLElement>('[data-spotify-embed]')!;

  // Resolves with the embed's controller once Spotify's player is ready to play.
  const loadPlayer = (uri: string) =>
    new Promise<EmbedController>((resolve, reject) => {
      (window as Window & { onSpotifyIframeApiReady?: (api: IFrameAPI) => void }).onSpotifyIframeApiReady = (api) =>
        api.createController(embed, { uri, width: 300, height: 80 }, resolve);
      const script = document.createElement('script');
      script.src = 'https://open.spotify.com/embed/iframe-api/v1';
      script.async = true;
      script.onerror = reject;
      document.head.append(script);
    });

  const load = async () => {
    const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
    const res = await fetch(`${base}spotify.json`, { cache: 'no-cache' });
    if (!res.ok) return;
    const track: RecentlyPlayed = await res.json();
    const title = `${track.songName} by ${track.artistName}`;
    const trackId = new URL(track.trackUrl).pathname.split('/').pop();

    label.querySelector('[data-song]')!.textContent = track.songName;
    label.querySelector('[data-artist]')!.textContent = track.artistName;
    label.title = title;
    button.disabled = false;

    const setPlaying = (playing: boolean) => {
      root.toggleAttribute('data-playing', playing);
      // The song is only shown while it plays; the label fades in each time.
      label.hidden = !playing;
      button.ariaPressed = String(playing);
      button.ariaLabel = `${playing ? 'Pause' : 'Play'} ${title}`;
    };
    setPlaying(false);

    // Until the player is ready (or if it is blocked), the vinyl opens the song on Spotify instead.
    let controller: EmbedController | undefined;
    button.addEventListener('click', () => {
      if (controller) controller.togglePlay();
      else window.open(track.trackUrl, '_blank', 'noopener');
    });

    controller = await loadPlayer(`spotify:track:${trackId}`);
    // Driven by the player's own updates, so the state also stays right when
    // playback stops on its own. At the end of the track the player can report
    // its position at the full duration without pausing, so that counts as stopped.
    controller.addListener('playback_update', ({ data }) =>
      setPlaying(!data.isPaused && !(data.duration > 0 && data.position >= data.duration)),
    );
  };

  load().catch(() => {});
</script>
