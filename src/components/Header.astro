---
import Avatar from '../assets/ax.svg';
import ExternalLink from './ExternalLink.astro';
import { site } from '../data/site';
---

<header>
  <Avatar width={64} height={64} fill="currentColor" aria-hidden="true" class="text-fg" />

  <h1 class="mt-10 text-h1">{site.name}</h1>
  <p>
    {site.roleHref ? <a href={site.roleHref} class="link">{site.role}</a> : site.role}
  </p>
  <p class="mt-6">
    <ExternalLink href={site.portfolio.href}>{site.portfolio.label}</ExternalLink>
  </p>
 
</header>
