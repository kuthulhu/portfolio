---
import { tabs } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<nav aria-label="Sections" transition:animate="none" class="-mx-6 mt-14 overflow-x-auto px-6 [scrollbar-width:none] sm:mx-0 sm:px-0">
  <ul class="flex gap-6">
    {
      tabs.map((tab) => {
        const active = isActive(tab.href);
        return (
          <li class="shrink-0">
            <a
              href={tab.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative block py-2 transition-colors duration-150',
                active ? 'text-fg' : 'text-muted [@media(hover:hover)_and_(pointer:fine)]:hover:text-fg',
              ]}
            >
              {tab.label}
              {active && (
                <span
                  aria-hidden="true"
                  transition:name="tab-indicator"
                  transition:animate="initial"
                  class="absolute inset-x-0 bottom-0.5 h-0.5 rounded-full bg-line"
                />
              )}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
