---
// Loaded as files rather than inlined: drawn into the page, their paths held up
// first paint. Only the lamp for the current theme is downloaded.
import lampOnUrl from '../assets/theme-switch/lamp-on.svg?no-inline';
import lampOffUrl from '../assets/theme-switch/lamp-off.svg?no-inline';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* Flips between light and dark without touching the system setting: the lamp is lit
    in light mode and off in dark mode. The drawings follow the dark: variant rather
    than aria-checked, so the right one shows on first paint. */}
<button
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Dark mode"
  data-theme-switch
  class:list={['block size-12 shrink-0 cursor-pointer rounded-full text-fg', className]}
>
  <span aria-hidden="true" class="lamp block size-12 dark:hidden" style={`--lamp: url(${lampOnUrl})`}></span>
  <span aria-hidden="true" class="lamp hidden size-12 dark:block" style={`--lamp: url(${lampOffUrl})`}></span>
</button>

<script>
  import switchOnUrl from '../assets/theme-switch/switch-on.wav';
  import switchOffUrl from '../assets/theme-switch/switch-off.wav';

  type Theme = 'light' | 'dark';
  // Read before first paint by the inline script in Layout.astro.
  const STORAGE_KEY = 'theme';

  const root = document.documentElement;
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  const current = (): Theme => (root.dataset.theme as Theme) ?? (systemDark.matches ? 'dark' : 'light');

  // The lamp's click, cut from one recording into its on and off halves. Each clip
  // starts right at the snap and plays through Web Audio, which starts sound sooner
  // than an <audio> element does. The clips are downloaded once the page has loaded
  // and gone idle; making the audio context at load blocked the main thread.
  //
  // Safari only plays sound started inside the click itself, so nothing on the way
  // from click to sound may wait. That rules out decodeAudioData, which is
  // asynchronous: the clips are mono 16-bit WAV, read into samples here as soon as
  // they arrive, and the click copies them into a buffer and starts it right away.
  type Clip = 'on' | 'off';
  const clipUrls: Record<Clip, string> = { on: switchOnUrl, off: switchOffUrl };
  const samples: Partial<Record<Clip, { rate: number; data: Float32Array<ArrayBuffer> }>> = {};

  // Walks the WAV's chunks for the sample rate (in "fmt ") and the samples ("data").
  const readWav = (bytes: ArrayBuffer) => {
    const view = new DataView(bytes);
    let rate = 44100;
    for (let offset = 12; offset + 8 <= view.byteLength; ) {
      const id = String.fromCharCode(...new Uint8Array(bytes, offset, 4));
      const size = view.getUint32(offset + 4, true);
      if (id === 'fmt ') rate = view.getUint32(offset + 12, true);
      if (id === 'data') {
        const data = new Float32Array(Math.floor(Math.min(size, view.byteLength - offset - 8) / 2));
        for (let i = 0; i < data.length; i++) data[i] = view.getInt16(offset + 8 + i * 2, true) / 32768;
        return { rate, data };
      }
      offset += 8 + size + (size % 2);
    }
  };

  let downloading = false;
  const download = () => {
    if (downloading) return;
    downloading = true;
    for (const clip of ['on', 'off'] as const) {
      fetch(clipUrls[clip])
        .then((response) => response.arrayBuffer())
        .then((bytes) => (samples[clip] = readWav(bytes)))
        .catch(() => {});
    }
  };

  const whenIdle = (callback: () => void) =>
    'requestIdleCallback' in window ? requestIdleCallback(callback, { timeout: 4000 }) : setTimeout(callback, 2000);
  if (document.readyState === 'complete') whenIdle(download);
  else addEventListener('load', () => whenIdle(download), { once: true });

  let context: AudioContext | undefined;
  const buffers: Partial<Record<Clip, AudioBuffer>> = {};
  const playClick = (clip: Clip) => {
    const sound = samples[clip];
    if (!sound) return;
    try {
      context ??= new AudioContext();
      context.resume();
      if (!buffers[clip]) {
        buffers[clip] = context.createBuffer(1, sound.data.length, sound.rate);
        buffers[clip].copyToChannel(sound.data, 0);
      }
      const source = context.createBufferSource();
      source.buffer = buffers[clip];
      source.connect(context.destination);
      source.start();
    } catch {}
  };

  const sync = () => {
    document.querySelectorAll('[data-theme-switch]').forEach((button) => {
      button.setAttribute('aria-checked', String(current() === 'dark'));
    });
  };

  document.querySelectorAll('[data-theme-switch]').forEach((button) => {
    // Reaching the switch before the page went idle starts the download early.
    button.addEventListener('pointerdown', download);
    button.addEventListener('focus', download);
    button.addEventListener('click', () => {
      const theme: Theme = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      playClick(theme === 'light' ? 'on' : 'off');
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch {}
      // The browser chrome follows the picked theme too, not the system one.
      document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((meta) => {
        meta.media = meta.dataset.scheme === theme ? 'all' : 'not all';
      });
      sync();
    });
  });

  // With no saved pick the page follows the system, so the switch does too.
  systemDark.addEventListener('change', sync);
  sync();
</script>
