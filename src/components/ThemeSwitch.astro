---
import LampOn from '../assets/lamp-on.svg';
import LampOff from '../assets/lamp-off.svg';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* Flips between light and dark without touching the system setting: the lamp is lit
    in light mode and off in dark mode. The drawings follow the dark: variant rather
    than aria-checked, so the right one shows on first paint. */}
<button
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Dark mode"
  data-theme-switch
  class:list={['block size-12 shrink-0 cursor-pointer rounded-full text-fg', className]}
>
  <LampOn width={48} height={48} fill="currentColor" aria-hidden="true" class="block dark:hidden" />
  <LampOff width={48} height={48} fill="currentColor" aria-hidden="true" class="hidden dark:block" />
</button>

<script>
  import switchOnUrl from '../assets/switch-on.wav';
  import switchOffUrl from '../assets/switch-off.wav';

  type Theme = 'light' | 'dark';
  // Read before first paint by the inline script in Layout.astro.
  const STORAGE_KEY = 'theme';

  const root = document.documentElement;
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  const current = (): Theme => (root.dataset.theme as Theme) ?? (systemDark.matches ? 'dark' : 'light');

  // The lamp's click, cut from one recording into its on and off halves. Each clip
  // starts right at the snap, and they're decoded up front and played through Web
  // Audio, which starts sound sooner than an <audio> element does.
  const audio = new AudioContext();
  const sounds: Partial<Record<'on' | 'off', AudioBuffer>> = {};
  const load = async (name: 'on' | 'off', url: string) => {
    try {
      const response = await fetch(url);
      sounds[name] = await audio.decodeAudioData(await response.arrayBuffer());
    } catch {}
  };
  load('on', switchOnUrl);
  load('off', switchOffUrl);

  const playClick = (on: boolean) => {
    const buffer = sounds[on ? 'on' : 'off'];
    if (!buffer) return;
    const source = audio.createBufferSource();
    source.buffer = buffer;
    source.connect(audio.destination);
    source.start();
  };

  const sync = () => {
    document.querySelectorAll('[data-theme-switch]').forEach((button) => {
      button.setAttribute('aria-checked', String(current() === 'dark'));
    });
  };

  document.querySelectorAll('[data-theme-switch]').forEach((button) => {
    // Browsers keep audio suspended until the visitor interacts. Waking it on press
    // means it's already running by the time the click lands.
    button.addEventListener('pointerdown', () => audio.resume());
    button.addEventListener('click', () => {
      audio.resume();
      const theme: Theme = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      playClick(theme === 'light');
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch {}
      // The browser chrome follows the picked theme too, not the system one.
      document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((meta) => {
        meta.media = meta.dataset.scheme === theme ? 'all' : 'not all';
      });
      sync();
    });
  });

  // With no saved pick the page follows the system, so the switch does too.
  systemDark.addEventListener('change', sync);
  sync();
</script>
