{/* Asks before Google Analytics may set cookies (see the Consent Mode setup in Layout.astro).
    Shown until the visitor picks, and again from any [data-cookie-settings] button.
    On phones it sits above the vinyl in RecentlyPlayed; from md up it is centred beside it.
    The right inset extends under the scrollbar (100vw - 100% is its width), so the banner
    centres on the full window like the page column does. */}
<div
  data-cookie-banner
  hidden
  role="region"
  aria-label="Cookie consent"
  class="cookie-banner fixed right-[max(16px,env(safe-area-inset-right))] bottom-[calc(max(16px,env(safe-area-inset-bottom))+60px)] left-[max(16px,env(safe-area-inset-left))] z-10 rounded-xl border border-line bg-bg/85 p-4 text-body-sm shadow-thumb backdrop-blur-sm md:right-[calc(100%-100vw)] md:bottom-[max(16px,env(safe-area-inset-bottom))] md:left-0 md:mx-auto md:w-[360px]"
>
  <p>I use Google Analytics cookies to see how many people visit. They're only set if you accept.</p>
  <div class="mt-3 flex gap-2">
    <button
      type="button"
      data-consent="granted"
      class="cursor-pointer rounded-md bg-fg px-3 py-1 font-medium text-bg"
    >
      Accept
    </button>
    <button
      type="button"
      data-consent="denied"
      class="cursor-pointer rounded-md border border-line px-3 py-1 font-medium text-fg"
    >
      Decline
    </button>
  </div>
</div>

<script>
  type Consent = 'granted' | 'denied';
  const STORAGE_KEY = 'analytics-consent';

  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]')!;
  // Defined in Layout.astro, in production builds only.
  const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;

  const stored = (): string | null => {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  };

  // GA's cookies are _ga and _ga_<id>, set on the site's top domain, so each is
  // cleared on the host and its parent domains.
  const clearAnalyticsCookies = () => {
    const parts = location.hostname.split('.');
    const domains = parts.map((_, i) => parts.slice(i).join('.'));
    for (const cookie of document.cookie.split('; ')) {
      const name = cookie.split('=')[0];
      if (!name.startsWith('_ga')) continue;
      for (const domain of ['', ...domains.map((d) => `; domain=${d}`)]) {
        document.cookie = `${name}=; max-age=0; path=/${domain}`;
      }
    }
  };

  const choose = (consent: Consent) => {
    try {
      localStorage.setItem(STORAGE_KEY, consent);
    } catch {}
    gtag?.('consent', 'update', { analytics_storage: consent });
    if (consent === 'denied') clearAnalyticsCookies();
    banner.hidden = true;
  };

  banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => {
    button.addEventListener('click', () => choose(button.dataset.consent as Consent));
  });

  document.querySelectorAll('[data-cookie-settings]').forEach((button) => {
    button.addEventListener('click', () => {
      banner.hidden = false;
      banner.querySelector<HTMLButtonElement>('[data-consent]')!.focus();
    });
  });

  if (!stored()) banner.hidden = false;
</script>
