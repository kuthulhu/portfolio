---
import { Font, Image } from 'astro:assets';
import backdrop from '../assets/back1.png';
import CookieBanner from '../components/CookieBanner.astro';
import RecentlyPlayed from '../components/RecentlyPlayed.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
// Link previews need absolute URLs, so these only render once `site` is set in astro.config.mjs.
const pageUrl = Astro.site && new URL(Astro.url.pathname, Astro.site);
const ogImage = Astro.site && site.ogImage && new URL(site.ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		{pageUrl && <link rel="canonical" href={pageUrl} />}
		{pageUrl && <meta property="og:url" content={pageUrl} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && <meta property="og:image:width" content="1200" />}
		{ogImage && <meta property="og:image:height" content="630" />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" data-scheme="light" />
		<meta name="theme-color" content="#0e0e0f" media="(prefers-color-scheme: dark)" data-scheme="dark" />
		{/* Applies a theme picked with ThemeSwitch before first paint, so the page doesn't
		    flash the system theme first. With no pick, the page follows the system. */}
		<script is:inline>
			try {
				const theme = localStorage.getItem('theme');
				if (theme === 'light' || theme === 'dark') {
					document.documentElement.dataset.theme = theme;
					document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
						meta.media = meta.dataset.scheme === theme ? 'all' : 'not all';
					});
				}
			} catch {}
		</script>
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<Font cssVariable="--font-inter" preload={[{ weight: '400' }]} />
		<Font cssVariable="--font-inter-tight" preload={[{ weight: '400' }]} />
		{/* Analytics only load in production builds so local dev visits aren't counted.
		    Consent Mode starts with all storage denied, so no cookies are set until the
		    visitor accepts in CookieBanner. A choice saved on an earlier visit is applied
		    here, before the config call, so returning visitors are counted from the first hit. */}
		{import.meta.env.PROD && (
			<>
				<script is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag() {
						dataLayer.push(arguments);
					}
					gtag('consent', 'default', {
						ad_storage: 'denied',
						ad_user_data: 'denied',
						ad_personalization: 'denied',
						analytics_storage: 'denied',
					});
					try {
						if (localStorage.getItem('analytics-consent') === 'granted') {
							gtag('consent', 'update', { analytics_storage: 'granted' });
						}
					} catch {}
					gtag('js', new Date());
					gtag('config', 'G-F1X8YCCX9G');
				</script>
				<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-F1X8YCCX9G"></script>
			</>
		)}
	</head>
	<body class="relative">
		{/* The body is positioned so the backdrop is placed against the full-width page, not the area beside the scrollbar. */}
		<Image
			src={backdrop}
			alt=""
			loading="eager"
			fetchpriority="high"
			class="pointer-events-none absolute top-0 right-0 w-[260px] select-none sm:w-[404px] dark:opacity-40"
		/>
		{/* In the page's top-right corner, over the backdrop. A classic scrollbar (about 15px)
		    covers the page's right edge, so the inset keeps the switch clear of it. */}
		<ThemeSwitch class="absolute top-[max(16px,env(safe-area-inset-top))] right-[max(16px,env(safe-area-inset-right))] z-10 sm:top-6 sm:right-6" />
		<div class="relative mx-auto max-w-[800px] pt-16 pr-[max(1.5rem,env(safe-area-inset-right))] pb-24 pl-[max(1.5rem,env(safe-area-inset-left))] sm:px-10 sm:pt-[72px]">
			<slot />
		</div>
		<RecentlyPlayed />
		<CookieBanner />
	</body>
</html>
