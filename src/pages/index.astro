---
import Layout from '../layouts/Layout.astro';
import { work } from '../data/site';
---

<Layout>
  <ul class="flex flex-col gap-5">
    {
      work.map((item) => (
        <li>
          <h2 class="text-h4">
            {item.href ? <a href={item.href} class="link">{item.title}</a> : item.title}
            {item.company && <>{' '}<span class="text-muted">at {item.company}</span></>}
          </h2>
          <p class="text-body-sm text-muted tabular-nums">
            {item.year}
            {item.type && <> ({item.type})</>}
          </p>
        </li>
      ))
    }
  </ul>
</Layout>
